{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020"],
    "types": ["node"],
    "outDir": "out",
    "rootDir": ".",
    "paths": {
      "lib/*": ["./lib/*"],
    },
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "lib/**/*",
    "examples/scripts/*",
    "validate.ts",
    "parse2ast.ts"
  ],
  "exclude": ["node_modules", "out"]
}