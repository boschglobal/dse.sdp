{
    "name": "@dse/dsl-parser",
    "version": "1.0.0",
    "description": "DSL Parser for DSE Simulation Definition, part of the Dynamic Simulation Environment",
    "homepage": "https://github.com/boschglobal/dse.sdp.git",
    "license": "Apache-2.0",
    "author": "Robert Bosch GmbH",
    "main": "out/parse2ast.js",
    "preferGlobal": true,
    "bin": {
        "dse-lang-compile": "out/validate.cjs",
        "dse-parse2ast": "out/parse2ast.js",
        "parse2ast": "out/parse2ast.js"
    },
    "directories": {
        "lib": "./lib"
    },
    "dependencies": {
        "chevrotain": "^13.0.0",
        "esbuild": "^0.25.1"
    },
    "devDependencies": {
        "@types/node": "^22.14.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "compile": "npx tsc -b && npm run build:validator",
        "build:validator": "esbuild validate.ts --bundle --platform=node --format=cjs --outfile=out/validate.cjs"
    }
}
